<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:padding="18dp" android:background="@drawable/widget_background">
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="一隅" android:textStyle="bold" android:textSize="20sp" android:textColor="@color/widget_text" />
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="想到什么，就记下来" android:textSize="12sp" android:textColor="@color/widget_secondary"
        android:layout_marginTop="4dp" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"
        android:gravity="bottom" android:orientation="horizontal" android:layout_marginTop="12dp">
        <TextView android:id="@+id/quick_text" android:layout_width="0dp" android:layout_weight="1"
            android:layout_height="44dp" android:gravity="center" android:background="@drawable/widget_action"
            android:text="＋ 记文字" android:textSize="14sp" android:textColor="@color/widget_accent" />
        <TextView android:id="@+id/quick_image" android:layout_width="0dp" android:layout_weight="1"
            android:layout_height="44dp" android:layout_marginStart="8dp" android:gravity="center"
            android:background="@drawable/widget_action" android:text="＋ 存图片" android:textSize="14sp"
            android:textColor="@color/widget_accent" />
    </LinearLayout>
</LinearLayout>
